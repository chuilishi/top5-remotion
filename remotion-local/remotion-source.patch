use std::ptr;
use std::sync::Once;

use ffmpeg_next::ffi::{
    av_buffer_ref, av_hwdevice_ctx_create, AVBufferRef, AVHWDeviceType,
};

use crate::global_printer::_print_verbose;

static INIT: Once = Once::new();
static mut HW_DEVICE_CTX: *mut AVBufferRef = ptr::null_mut();
static mut CUDA_AVAILABLE: bool = false;

pub fn init_cuda_device_ctx() {
    INIT.call_once(|| unsafe {
        let ret = av_hwdevice_ctx_create(
            &raw mut HW_DEVICE_CTX as *mut *mut AVBufferRef,
            AVHWDeviceType::AV_HWDEVICE_TYPE_CUDA,
            ptr::null(),
            ptr::null_mut(),
            0,
        );
        if ret >= 0 && !HW_DEVICE_CTX.is_null() {
            CUDA_AVAILABLE = true;
            let _ = _print_verbose("NVDEC: CUDA device context created successfully");
        } else {
            CUDA_AVAILABLE = false;
            let _ = _print_verbose(&format!(
                "NVDEC: CUDA device context creation failed (err={}), using software decoding",
                ret
            ));
        }
    });
}

pub fn is_cuda_available() -> bool {
    unsafe { CUDA_AVAILABLE }
}

pub fn get_cuda_device_ref() -> *mut AVBufferRef {
    unsafe {
        if CUDA_AVAILABLE && !HW_DEVICE_CTX.is_null() {
            av_buffer_ref(HW_DEVICE_CTX)
        } else {
            ptr::null_mut()
        }
    }
}
