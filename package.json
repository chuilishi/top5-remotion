{
  "name": "top5-video-template",
  "version": "1.0.0",
  "description": "Top 5 Series Video Template - Remotion",
  "scripts": {
    "config": "node scripts/build-config.mjs",
    "project": "node scripts/switch-project.mjs",
    "switch": "node scripts/switch-project.mjs",
    "prestart": "npm run config",
    "start": "npx remotion studio",
    "prebuild": "npm run config",
    "build": "node scripts/render.mjs out/video.mp4 --video-bitrate=10M --x264-preset=veryfast --offthreadvideo-video-threads=4",
    "build:fast": "node scripts/render.mjs out/video.mp4 --video-bitrate=10M --x264-preset=veryfast --offthreadvideo-video-threads=4",
    "upgrade": "npx remotion upgrade",
    "dev": "npm run start",
    "relay": "node prompt-relay/server.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.525",
    "@remotion/effects": "4.0.525",
    "@remotion/light-leaks": "4.0.525",
    "@remotion/media": "4.0.525",
    "@remotion/sfx": "4.0.525",
    "@remotion/starburst": "4.0.525",
    "@remotion/transitions": "4.0.525",
    "js-yaml": "^4.1.0",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.525",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config": "4.0.525",
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
