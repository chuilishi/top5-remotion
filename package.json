    "js-yaml": "^4.1.0",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "file:remotion-local/remotion-4.0.470.tgz",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config": "file:remotion-local/remotion-eslint-config-4.0.470.tgz",
    "@types/react": "^18.3.12",
